diff --git a/lib/device/dev-cache.c b/lib/device/dev-cache.c
index 2047784..8f55e0d 100644
--- a/lib/device/dev-cache.c
+++ b/lib/device/dev-cache.c
@@ -719,2 +719,12 @@ static int _insert_dev(const char *path, dev_t d)
 	struct device *dev_by_path;
+	static dev_t loopfile_count = 0;
+	int loopfile = 0;
+
+	/* Use synthetic device numbers for explicitly configured regular files. */
+	if (!d) {
+		if (dev_cache_get_dev_by_name(path))
+			return 1;
+		d = ++loopfile_count;
+		loopfile = 1;
+	}
 
@@ -742,2 +752,4 @@ static int _insert_dev(const char *path, dev_t d)
 				return_0;
+		if (loopfile)
+			dev->flags |= DEV_REGULAR;
 
@@ -1201,2 +1213,5 @@ void dev_cache_scan(struct cmd_context *cmd)
 {
+	struct dir_list *dl;
+	struct stat info;
+
 	log_debug_devs("Creating list of system devices.");
@@ -1209,2 +1224,7 @@ void dev_cache_scan(struct cmd_context *cmd)
 
+	dm_list_iterate_items(dl, &_cache.files) {
+		if (!stat(dl->dir, &info) && S_ISREG(info.st_mode))
+			(void) _insert_dev(dl->dir, 0);
+	}
+
 	if (cmd->check_devs_used)
@@ -1437,2 +1457,3 @@ int dev_cache_init(struct cmd_context *cmd)
 	dm_list_init(&_cache.dirs);
+	dm_list_init(&_cache.files);
 
@@ -1564,2 +1585,29 @@ int dev_cache_add_dir(const char *path)
 
+int dev_cache_add_loopfile(const char *path)
+{
+	struct dir_list *dl;
+	struct stat st;
+	size_t len;
+
+	if (stat(path, &st)) {
+		log_warn("Ignoring %s: %s.", path, strerror(errno));
+		return 1;
+	}
+
+	if (!S_ISREG(st.st_mode)) {
+		log_warn("Ignoring %s: Not a regular file.", path);
+		return 1;
+	}
+
+	len = strlen(path);
+	if (!(dl = _zalloc(sizeof(*dl) + len + 1))) {
+		log_error("dir_list allocation failed for file");
+		return 0;
+	}
+
+	memcpy(dl->dir, path, len + 1);
+	dm_list_add(&_cache.files, &dl->list);
+	return 1;
+}
+
 struct device *dev_cache_get_dev_by_name(const char *name)
